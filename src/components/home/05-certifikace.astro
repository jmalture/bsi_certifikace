---
import Icon from '../ui/Icon.astro';
import Bubbles from '../ui/Bubbles.astro';
import Rise from '../ui/Rise.astro';
import Ribbon from '../ui/Ribbon.astro';
import { pick, type Lang } from '../../i18n';
import home from '../../i18n/home.json';
interface Props {
  lang: Lang;
}
const t = pick(home, Astro.props.lang);
---

<section class="bs-section bs-cert" id="certifikace">
  <Ribbon class="bs-sec-ribbon" seed={9} />
  <Rise
    n={14}
    rings={[
      { x: 8, y: 22, s: 480 },
      { x: 92, y: 70, s: 420 },
    ]}
  />
  <Bubbles
    items={[
      { s: 460, x: 94, y: 22, tone: 'sky' },
      { s: 300, x: 4, y: 78 },
      { s: 160, x: 50, y: 48 },
    ]}
  />
  <div class="bs-wrap">
    <div class="bs-cert__head">
      <p class="bs-kicker" data-reveal>{t.cert_kicker}</p>
      <h2 class="bs-h2 bs-lines">
        <span class="bs-line"><span>{t.cert_h2_a}</span></span>
        <span class="bs-line" style="--l:1"><span class="bs-grad">{t.cert_h2_b}</span></span>
      </h2>
      <div class="bs-cert__intro">
        <p data-reveal style="--i:1">{t.cert_p1}</p>
        <p data-reveal style="--i:2">{t.cert_p2}</p>
      </div>
    </div>

    <h3 class="bs-cert__h3" data-reveal>{t.help_h3}</h3>
    <ul class="bs-cert__cards">
      {
        t.help.map((h, i) => (
          <li class="bs-card" data-reveal="pop" style={`--i:${i}`}>
            <span class="bs-card__ic">
              <Icon name="check" size={26} />
            </span>
            <p>{h}</p>
          </li>
        ))
      }
    </ul>

    <div class="bs-path" aria-label={t.path_label}>
      <div class="bs-journey" data-journey>
        <p class="bs-journey__label">{t.path_label}</p>
        <div class="bs-journey__stage">
          <span class="bs-journey__line" aria-hidden="true"><i></i><em></em></span>
          <ol class="bs-journey__steps">
            <li class="bs-step" style="--n:0">
              <span class="bs-step__orb"><b>1</b></span>
              <span class="bs-step__t">{t.step_a}</span>
            </li>
            <li class="bs-step" style="--n:1">
              <span class="bs-step__orb"><b>2</b></span>
              <span class="bs-step__t">{t.step_b}</span>
            </li>
            <li class="bs-step bs-step--final" style="--n:2">
              <span class="bs-step__orb">
                <i class="bs-step__ring"></i><i class="bs-step__ring"></i>
                <Icon name="check" size={46} />
              </span>
              <span class="bs-step__t">{t.step_c}</span>
            </li>
          </ol>
        </div>
      </div>
      <div class="bs-path__grid">
        <article class="bs-path__card" data-reveal="left">
          <h3>{t.step1_h3}</h3>
          <p class="bs-path__lead">{t.step1_lead}</p>
          {t.step1_p.map((p) => <p>{p}</p>)}
          <dl class="bs-path__stats">
            <div>
              <dt><b data-count={t.stat_days_n}>{t.stat_days_n}</b></dt>
              <dd>{t.stat_days_l}</dd>
            </div>
            <div>
              <dt><b data-count={t.stat_blocks_n}>{t.stat_blocks_n}</b></dt>
              <dd>{t.stat_blocks_l}</dd>
            </div>
          </dl>
        </article>
        <article class="bs-path__card bs-path__card--dark" data-reveal="right">
          <h3>{t.step2_h3}</h3>
          <p class="bs-path__lead">{t.step2_lead}</p>
          <p>{t.step2_p}</p>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  const journeys = document.querySelectorAll<HTMLElement>('[data-journey]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (en) =>
        en.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.45 },
    );
    journeys.forEach((j) => io.observe(j));
  } else journeys.forEach((j) => j.classList.add('is-in'));
</script>

<style is:global>
  .bs-cert {
    background: linear-gradient(180deg, #fff 0%, var(--bs-mist) 100%);
    border-radius: var(--bs-r-lg) var(--bs-r-lg) 0 0;
    margin-top: calc(var(--bs-r-lg) * -1);
    z-index: 1;
  }
  .bs-cert__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(28px, 6vw, 100px);
    align-items: end;
  }
  .bs-cert__head .bs-kicker,
  .bs-cert__head .bs-h2 {
    grid-column: 1;
  }
  .bs-cert__intro {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    gap: 16px;
    color: var(--bs-grey);
  }
  .bs-cert__intro p:first-child {
    color: var(--bs-ink);
    font-size: 1.12rem;
  }
  .bs-cert__h3 {
    margin: clamp(56px, 7vw, 96px) 0 24px;
    font-size: var(--bs-h3);
    color: var(--bs-navy);
  }
  .bs-cert__cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .bs-card {
    display: grid;
    gap: 18px;
    align-content: start;
    padding: 28px 26px 32px;
    background: #fff;
    border: 1px solid var(--bs-line);
    border-radius: var(--bs-r);
    transition:
      transform var(--bs-med) var(--bs-ease),
      box-shadow var(--bs-med) var(--bs-ease),
      background-color var(--bs-med) var(--bs-ease),
      color var(--bs-med) var(--bs-ease),
      opacity var(--bs-slow) var(--bs-ease),
      translate var(--bs-slow) var(--bs-ease),
      scale var(--bs-slow) var(--bs-ease);
  }
  .bs-card:hover {
    background: var(--bs-navy);
    color: #fff;
    transform: translateY(-8px);
    box-shadow: var(--bs-shadow-lg);
  }
  .bs-card__ic {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--bs-blob);
    background: var(--bs-sky);
    color: var(--bs-navy);
    transition: background-color var(--bs-med) var(--bs-ease);
  }
  .bs-card:hover .bs-card__ic {
    background: var(--bs-blue);
  }
  .bs-card p {
    font-weight: 600;
    line-height: 1.5;
  }

  .bs-path {
    margin-top: clamp(64px, 8vw, 120px);
  }
  .bs-journey {
    position: relative;
    margin-bottom: clamp(36px, 5vw, 72px);
    padding: clamp(28px, 4vw, 56px) clamp(20px, 4vw, 64px) clamp(32px, 4vw, 56px);
    border-radius: var(--bs-r-lg);
    background: linear-gradient(135deg, var(--bs-navy-d) 0%, var(--bs-navy) 100%);
    color: #fff;
    overflow: clip;
  }
  .bs-journey::before {
    content: '';
    position: absolute;
    width: 420px;
    aspect-ratio: 1;
    right: -120px;
    top: -200px;
    border-radius: var(--bs-blob);
    background: rgba(0, 156, 221, 0.18);
    animation: bs-morph 20s ease-in-out infinite alternate;
  }
  .bs-journey__label {
    position: relative;
    margin-bottom: clamp(28px, 4vw, 56px);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bs-blue-l);
  }
  .bs-journey__stage {
    position: relative;
  }
  .bs-journey__steps {
    position: relative;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .bs-step {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 22px;
    text-align: center;
  }
  .bs-step__orb {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(88px, 11vw, 140px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff;
    color: var(--bs-navy);
    box-shadow: 0 0 0 10px rgba(255, 255, 255, 0.08);
  }
  .bs-step__orb b {
    font-size: clamp(2.2rem, 1.4rem + 2.6vw, 3.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .bs-step--final .bs-step__orb {
    background: linear-gradient(140deg, var(--bs-blue) 0%, var(--bs-blue-d) 100%);
    color: #fff;
    box-shadow: 0 0 0 10px rgba(0, 156, 221, 0.22);
  }
  .bs-step__t {
    font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .bs-step--final .bs-step__t {
    color: var(--bs-blue-l);
  }
  .bs-step__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--bs-blue-l);
    opacity: 0;
  }
  /* the line sits behind the orbs, at orb-centre height */
  .bs-journey__line {
    position: absolute;
    z-index: 0;
    left: calc(100% / 6);
    right: calc(100% / 6);
    top: calc(clamp(88px, 11vw, 140px) / 2 - 2px);
    height: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.14);
    overflow: clip;
  }
  .bs-journey__line i {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #fff, var(--bs-blue-l));
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .bs-journey__line em {
    position: absolute;
    top: -3px;
    left: 0;
    width: 90px;
    height: 10px;
    border-radius: 10px;
    background: linear-gradient(90deg, transparent, #fff, transparent);
    opacity: 0;
  }

  /* play once when the band enters the screen */
  .js .bs-step__orb {
    scale: 0;
  }
  .js .bs-step__t {
    opacity: 0;
    translate: 0 14px;
  }
  .js .bs-journey.is-in .bs-step__orb {
    animation: bs-orb 0.9s var(--bs-ease) both;
    animation-delay: calc(var(--n) * 1.05s + 0.15s);
  }
  .js .bs-journey.is-in .bs-step__t {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.8s var(--bs-ease),
      translate 0.8s var(--bs-ease);
    transition-delay: calc(var(--n) * 1.05s + 0.55s);
  }
  .js .bs-journey.is-in .bs-journey__line i {
    transform: scaleX(1);
    transition: transform 2.1s var(--bs-ease-io) 0.5s;
  }
  .js .bs-journey.is-in .bs-journey__line em {
    animation: bs-travel 3.6s linear 3s infinite;
  }
  .js .bs-journey.is-in .bs-step--final .bs-step__ring {
    animation: bs-ripple 2.6s ease-out 2.4s infinite;
  }
  .js .bs-journey.is-in .bs-step--final .bs-step__ring:nth-child(2) {
    animation-delay: 3.7s;
  }
  .js .bs-journey.is-in .bs-step--final .bs-step__orb {
    animation:
      bs-orb 0.9s var(--bs-ease) 2.25s both,
      bs-glow 3s ease-in-out 3.3s infinite;
  }
  @keyframes bs-orb {
    0% {
      scale: 0;
    }
    60% {
      scale: 1.12;
    }
    100% {
      scale: 1;
    }
  }
  @keyframes bs-ripple {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }
  @keyframes bs-glow {
    50% {
      box-shadow: 0 0 0 22px rgba(0, 156, 221, 0.08);
    }
  }
  @keyframes bs-travel {
    0% {
      left: -90px;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }
  @media (max-width: 600px) {
    .bs-journey__steps {
      gap: 6px;
    }
    .bs-step__t {
      font-size: 1.02rem;
    }
  }
  .bs-path__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 22px;
  }
  .bs-path__card {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: clamp(28px, 3.4vw, 52px);
    background: #fff;
    border-radius: var(--bs-r-lg);
    border: 1px solid var(--bs-line);
    color: var(--bs-grey);
  }
  .bs-path__card h3 {
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.3rem);
    color: var(--bs-navy);
  }
  .bs-path__lead {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--bs-ink);
  }
  .bs-path__card--dark {
    background: var(--bs-navy);
    border-color: transparent;
    color: rgba(255, 255, 255, 0.82);
  }
  .bs-path__card--dark h3,
  .bs-path__card--dark .bs-path__lead {
    color: #fff;
  }
  .bs-path__stats {
    margin: 12px 0 0;
    display: flex;
    gap: clamp(24px, 4vw, 56px);
    padding-top: 24px;
    border-top: 1px solid var(--bs-line);
  }
  .bs-path__stats dt {
    font-size: clamp(2.8rem, 2rem + 2.4vw, 4.4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--bs-blue-d);
  }
  .bs-path__stats dd {
    margin: 6px 0 0;
    font-size: 0.875rem;
    font-weight: 600;
    max-width: 12em;
  }
  @media (max-width: 1000px) {
    .bs-cert__cards {
      grid-template-columns: 1fr 1fr;
    }
    .bs-path__grid,
    .bs-cert__head {
      grid-template-columns: 1fr;
    }
    .bs-cert__intro {
      grid-column: 1;
      grid-row: auto;
      margin-top: 28px;
    }
  }
  @media (max-width: 560px) {
    .bs-cert__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
