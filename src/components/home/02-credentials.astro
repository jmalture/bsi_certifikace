---
import { pick, type Lang } from '../../i18n';
import home from '../../i18n/home.json';
interface Props {
  lang: Lang;
}
const t = pick(home, Astro.props.lang);
---

<section class="bs-cred" aria-label={t.cred_label}>
  <ul class="bs-wrap bs-cred__list">
    {
      t.cred.map((c, i) => (
        <li data-reveal style={`--i:${i}`}>
          <b>{c.k}</b>
          <span>{c.v}</span>
        </li>
      ))
    }
  </ul>
</section>

<style is:global>
  .bs-cred {
    position: relative;
    z-index: 2;
    margin-top: calc(var(--bs-r-lg) * -1.4);
  }
  .bs-cred__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    background: var(--bs-navy);
    color: #fff;
    border-radius: var(--bs-r-lg);
    max-width: var(--bs-max);
    box-shadow: var(--bs-shadow-lg);
    overflow: clip;
  }
  .bs-cred__list li {
    padding: 30px clamp(20px, 2.4vw, 36px);
    display: grid;
    gap: 6px;
    align-content: start;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    transition: background-color var(--bs-med) var(--bs-ease);
  }
  .bs-cred__list li:first-child {
    border-left: 0;
  }
  .bs-cred__list li:hover {
    background: var(--bs-navy-2);
  }
  .bs-cred__list b {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .bs-cred__list span {
    font-size: 0.875rem;
    color: var(--bs-blue-l);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .bs-cred__list {
      grid-template-columns: 1fr 1fr;
      width: calc(100% - 2 * var(--bs-gutter));
    }
    .bs-cred__list li:nth-child(3) {
      border-left: 0;
    }
    .bs-cred__list li:nth-child(n + 3) {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
  }
</style>
