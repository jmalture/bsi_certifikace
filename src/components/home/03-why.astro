---
import Icon from '../ui/Icon.astro';
import { pick, URLS, type Lang } from '../../i18n';
import home from '../../i18n/home.json';
interface Props {
  lang: Lang;
}
const t = pick(home, Astro.props.lang);
const total = String(t.why_points.length).padStart(2, '0');
---

<section class="bs-why" id="bimPoint">
  <div class="bs-wrap bs-why__in">
    <div class="bs-why__intro">
      <p class="bs-kicker" data-reveal>{t.why_kicker}</p>
      <h2 class="bs-h2 bs-lines"><span class="bs-line"><span>{t.why_h2}</span></span></h2>
      <p class="bs-why__lead" data-reveal style="--i:1">{t.why_lead}</p>
      <a class="bs-btn bs-btn--blue" href={URLS.bimpoint} target="_blank" rel="noopener" data-reveal style="--i:2">
        {t.why_cta}
        <Icon name="arrow" size={18} />
      </a>
    </div>

    <ol class="bs-why__list">
      {
        t.why_points.map((p, i) => (
          <li class="bs-pt" style={`--k:${i}`} data-reveal tabindex="0">
            <span class="bs-pt__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p>{p}</p>
            <span class="bs-pt__go" aria-hidden="true">
              <Icon name="arrow" size={20} />
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  .bs-why {
    position: relative;
    padding-block: clamp(72px, 9vw, 130px);
    background: linear-gradient(180deg, #fff 0%, var(--bs-mist) 100%);
    overflow: clip;
  }
  .bs-why__in {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }
  .bs-why__intro {
    display: grid;
    justify-items: start;
    align-content: start;
  }
  .bs-why__lead {
    margin: 24px 0 32px;
    font-size: var(--bs-lead);
    line-height: 1.6;
    color: var(--bs-navy);
  }
  .bs-why__list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: pt;
  }
  .bs-pt {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    padding: clamp(22px, 2.6vw, 34px) clamp(16px, 2vw, 28px);
    border-radius: 14px;
    color: var(--bs-ink);
    outline: none;
    isolation: isolate;
    overflow: clip;
  }
  /* hairline above each row draws in from the left */
  .bs-pt::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, var(--bs-blue), var(--bs-line) 60%);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 1.2s var(--bs-ease);
    transition-delay: calc(var(--k) * 90ms + 200ms);
  }
  .bs-pt.is-in::before {
    transform: scaleX(1);
  }
  .bs-pt:last-child {
    border-bottom: 2px solid var(--bs-line);
    border-radius: 14px 14px 0 0;
  }
  /* navy fill slides in from the left */
  .bs-pt::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, var(--bs-navy) 0%, var(--bs-navy-2) 100%);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.7s var(--bs-ease);
  }
  .bs-pt:hover::after,
  .bs-pt:focus-visible::after {
    transform: scaleX(1);
  }
  .bs-pt__n {
    min-width: 2.3ch;
    font-size: clamp(2.6rem, 2rem + 2.6vw, 4.4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--bs-blue);
    transition:
      color var(--bs-med) var(--bs-ease),
      -webkit-text-stroke-color var(--bs-med) var(--bs-ease);
  }
  .bs-pt p {
    margin: 0;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.18rem);
    line-height: 1.55;
    transition: color var(--bs-med) var(--bs-ease);
  }
  .bs-pt__go {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--bs-blue);
    opacity: 0.55;
    transition:
      transform var(--bs-med) var(--bs-ease),
      color var(--bs-med) var(--bs-ease),
      opacity var(--bs-med) var(--bs-ease);
  }
  .bs-pt:hover .bs-pt__n,
  .bs-pt:focus-visible .bs-pt__n {
    color: var(--bs-blue);
    -webkit-text-stroke-color: var(--bs-blue);
  }
  .bs-pt:hover p,
  .bs-pt:focus-visible p {
    color: #fff;
  }
  .bs-pt:hover .bs-pt__go,
  .bs-pt:focus-visible .bs-pt__go {
    transform: translateX(6px);
    color: #fff;
    opacity: 1;
  }
  @media (max-width: 560px) {
    .bs-pt {
      grid-template-columns: auto 1fr;
    }
    .bs-pt__go {
      display: none;
    }
  }

  @media (min-width: 901px) {
    .bs-why__in {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }
    .bs-why__intro {
      position: sticky;
      top: calc(var(--bs-header-h, 84px) + 40px);
    }
  }
</style>
