---
import Icon from '../ui/Icon.astro';
import Bubbles from '../ui/Bubbles.astro';
import { pick, URLS, type Lang } from '../../i18n';
import home from '../../i18n/home.json';
interface Props {
  lang: Lang;
}
const t = pick(home, Astro.props.lang);
const total = String(t.why_points.length).padStart(2, '0');
---

<section class="bs-why" id="bimPoint">
  <Bubbles
    items={[
      { s: 520, x: 8, y: 20 },
      { s: 300, x: 62, y: 86, tone: 'sky' },
      { s: 420, x: 92, y: 14, tone: 'sky' },
      { s: 180, x: 40, y: 8 },
    ]}
  />
  <div class="bs-wrap bs-why__in">
    <div class="bs-why__intro">
      <p class="bs-kicker" data-reveal>{t.why_kicker}</p>
      <h2 class="bs-h2 bs-lines"><span class="bs-line"><span>{t.why_h2}</span></span></h2>
      <p class="bs-why__lead" data-reveal style="--i:1">{t.why_lead}</p>
      <a class="bs-btn bs-btn--blue" href={URLS.bimpoint} target="_blank" rel="noopener" data-reveal style="--i:2">
        {t.why_cta}
        <Icon name="arrow" size={18} />
      </a>
    </div>

    <div class="bs-why__bubs">
      {
        t.why_points.map((p, i) => (
          <article class="bs-bub" style={`--k:${i}`} data-reveal="pop" tabindex="0">
            <span class="bs-bub__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p>{p}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .bs-why {
    position: relative;
    padding-block: clamp(72px, 9vw, 130px);
    background: linear-gradient(180deg, #fff 0%, var(--bs-mist) 100%);
    overflow: clip;
  }
  .bs-why__in {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }
  .bs-why__intro {
    display: grid;
    justify-items: start;
    align-content: start;
  }
  .bs-why__lead {
    margin: 24px 0 32px;
    font-size: var(--bs-lead);
    line-height: 1.6;
    color: var(--bs-navy);
  }
  .bs-why__bubs {
    display: grid;
    gap: 24px;
    justify-items: center;
  }

  /* Bubbles: soft morphing blobs with the text inside; hover or focus fills one navy */
  .bs-bub {
    position: relative;
    display: grid;
    align-content: center;
    --w: min(86vw, 380px);
    width: var(--w);
    aspect-ratio: 1;
    padding: calc(var(--w) * 0.15);
    border-radius: var(--bs-blob);
    background: linear-gradient(150deg, #fff 0%, var(--bs-sky-2) 60%, var(--bs-sky) 130%);
    border: 1.5px solid var(--bs-line);
    box-shadow: var(--bs-shadow);
    color: var(--bs-ink);
    outline: none;
    animation: bs-bub-morph 14s ease-in-out infinite alternate;
    animation-delay: calc(var(--k) * -3s);
    transition:
      background-color var(--bs-slow) var(--bs-ease),
      color var(--bs-med) var(--bs-ease),
      box-shadow var(--bs-med) var(--bs-ease),
      scale var(--bs-slow) var(--bs-ease),
      opacity var(--bs-slow) var(--bs-ease),
      translate var(--bs-slow) var(--bs-ease);
    transition-delay: calc(var(--k) * 70ms), 0s, 0s, 0s, calc(var(--k) * 70ms), calc(var(--k) * 70ms);
  }
  .bs-bub:nth-of-type(even) {
    border-radius: var(--bs-blob-2);
  }
  @keyframes bs-bub-morph {
    50% {
      border-radius: var(--bs-blob-2);
    }
    100% {
      border-radius: 58% 42% 40% 60% / 44% 56% 44% 56%;
    }
  }
  .bs-bub p {
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.08rem);
    line-height: 1.55;
  }
  .bs-bub__n {
    position: absolute;
    top: 8%;
    left: 8%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--bs-blue);
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
    box-shadow: 0 10px 24px rgba(0, 156, 221, 0.4);
  }
  .bs-bub::before,
  .bs-bub::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: var(--bs-blue);
    opacity: 0.18;
    animation: bs-float 7s ease-in-out infinite alternate;
  }
  .bs-bub::before {
    width: 38px;
    height: 38px;
    right: 6%;
    top: 10%;
  }
  .bs-bub::after {
    width: 18px;
    height: 18px;
    right: 18%;
    bottom: 6%;
    animation-delay: -3s;
  }
  @keyframes bs-float {
    to {
      transform: translate(-8px, -16px);
    }
  }
  .bs-bub:hover,
  .bs-bub:focus-visible {
    background: linear-gradient(150deg, var(--bs-navy-2) 0%, var(--bs-navy) 100%);
    color: #fff;
    border-color: transparent;
    box-shadow: var(--bs-shadow-lg);
  }
  .bs-bub:hover p,
  .bs-bub:focus-visible p {
    color: #fff;
  }

  .js .bs-bub[data-reveal] {
    transition:
      background-color var(--bs-slow) var(--bs-ease),
      color var(--bs-med) var(--bs-ease),
      box-shadow var(--bs-med) var(--bs-ease),
      opacity var(--bs-slow) var(--bs-ease),
      translate var(--bs-slow) var(--bs-ease),
      scale var(--bs-slow) var(--bs-ease);
    transition-delay: 0s, 0s, 0s, calc(var(--k) * 90ms), calc(var(--k) * 90ms), calc(var(--k) * 90ms);
  }
  .js .bs-bub.is-in:hover,
  .js .bs-bub.is-in:focus-visible {
    scale: 1.05;
    transition-delay: 0s;
  }

  @media (min-width: 901px) {
    .bs-why__in {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }
    .bs-why__intro {
      position: sticky;
      top: calc(var(--bs-header-h, 84px) + 40px);
    }
    .bs-why__bubs {
      grid-template-columns: 1fr 1fr;
      gap: 28px clamp(8px, 2vw, 28px);
    }
    .bs-bub {
      --w: min(100%, 400px);
    }
    .bs-bub:nth-of-type(even) {
      margin-top: 72px;
    }
    .bs-bub:nth-of-type(5) {
      grid-column: 1 / -1;
      margin-top: -20px;
    }
  }
</style>
