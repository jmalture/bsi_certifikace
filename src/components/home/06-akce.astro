---
import Icon from '../ui/Icon.astro';
import Bubbles from '../ui/Bubbles.astro';
import { pick, URLS, FIRM, type Lang } from '../../i18n';
import home from '../../i18n/home.json';
interface Props {
  lang: Lang;
}
const t = pick(home, Astro.props.lang);
---

<section class="bs-akce bs-dark" id="akce">
  <Bubbles
    items={[
      { s: 360, x: 88, y: 30, tone: 'navy' },
      { s: 200, x: 64, y: 88, tone: 'navy' },
    ]}
  />
  <div class="bs-akce__blob" aria-hidden="true"></div>
  <div class="bs-wrap bs-akce__in">
    <div class="bs-akce__num" data-reveal="pop" aria-hidden="true">
      <b data-count={t.akce_n}>{t.akce_n}</b><i>{t.akce_unit}</i>
    </div>
    <div class="bs-akce__copy">
      <p class="bs-kicker" data-reveal>{t.akce_kicker}</p>
      <h2 class="bs-h2 bs-lines"><span class="bs-line"><span>{t.akce_h2}</span></span></h2>
      <p class="bs-akce__p" data-reveal style="--i:1">{t.akce_p}</p>
      <p class="bs-akce__p2" data-reveal style="--i:2">{t.akce_p2}</p>
      <a class="bs-btn bs-btn--white" href={`mailto:${FIRM.mail}`} data-reveal style="--i:3">
        {FIRM.mail}
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>

<style is:global>
  .bs-akce {
    position: relative;
    overflow: clip;
    padding-block: clamp(72px, 9vw, 130px);
    background: linear-gradient(120deg, var(--bs-blue-d) 0%, var(--bs-navy) 70%);
  }
  .bs-akce__blob {
    position: absolute;
    width: min(70vw, 820px);
    aspect-ratio: 1;
    left: -16vw;
    top: 50%;
    translate: 0 -50%;
    border-radius: var(--bs-blob);
    background: rgba(255, 255, 255, 0.07);
    animation: bs-morph 20s ease-in-out infinite alternate;
  }
  .bs-akce__in {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(32px, 7vw, 120px);
  }
  .bs-akce__num {
    display: flex;
    align-items: flex-start;
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.06em;
    font-size: clamp(7rem, 4rem + 15vw, 18rem);
    color: #fff;
  }
  .bs-akce__num b {
    font-weight: 800;
    min-width: 1.2em;
    font-variant-numeric: tabular-nums;
  }
  .bs-akce__num i {
    font-style: normal;
    font-size: 0.5em;
    color: var(--bs-blue-l);
    margin-left: 0.05em;
  }
  .bs-akce__p {
    margin-top: 22px;
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.7rem);
    font-weight: 700;
    line-height: 1.35;
    max-width: 24em;
  }
  .bs-akce__p2 {
    margin: 12px 0 32px;
    color: rgba(255, 255, 255, 0.8);
  }
  @media (max-width: 800px) {
    .bs-akce__in {
      grid-template-columns: 1fr;
    }
  }
</style>
